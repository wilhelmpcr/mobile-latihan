<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_light">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tentang Bina Desa"
        android:textColor="@color/text_main"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Bina Desa adalah platform digital yang dirancang untuk mempercepat distribusi bantuan sosial dan transparansi data ditingkat desa. Aplikasi ini memungkinkan masyarakat mengakses layanan secara mandiri."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Fitur Utama:"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• Kalkulator Bantuan Terintegrasi\n• Akses Web Portal Bina Desa\n• Autentikasi Keamanan SharedPreferences"
        android:textColor="@color/text_secondary" />

</LinearLayout>