<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOMBOL 1: Elevated -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRumus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        android:clickable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📐 Rumus Bangun Ruang"
            android:padding="20dp"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- TOMBOL 2: Filled -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCustom1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="?attr/materialCardViewFilledStyle"
        app:cardCornerRadius="12dp"
        android:clickable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️ Custom Menu 1"
            android:padding="20dp"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- TOMBOL 3: Filled -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCustom2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="?attr/materialCardViewFilledStyle"
        app:cardCornerRadius="12dp"
        android:clickable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Custom Menu 2"
            android:padding="20dp"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- TOMBOL 4: Outlined -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?attr/materialCardViewOutlinedStyle"
        app:strokeColor="#B3261E"
        app:strokeWidth="2dp"
        app:cardCornerRadius="12dp"
        android:clickable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚪 Logout"
            android:padding="20dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#B3261E"/>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>